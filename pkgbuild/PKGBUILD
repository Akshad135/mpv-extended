pkgname=reel
pkgver=0.1.0
pkgrel=1
pkgdesc='A video player for Omarchy, built on libmpv'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'mpv' 'ffmpeg' 'xdg-desktop-portal')
optdepends=('yt-dlp: play links from YouTube and other sites')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/reel "$pkgdir/usr/bin/reel"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/reel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/reel.svg"
  install -Dm644 "$startdir/reel.desktop" "$pkgdir/usr/share/applications/reel.desktop"
}
