[Desktop Entry]
Type=Application
Name=mpv-extended
GenericName=Video Player
Comment=Watch videos, pick up where you left off
Exec=mpv-extended %U
Icon=mpv-extended
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;player;mpv;media;
MimeType=video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-flv;video/mpeg;video/ogg;video/3gpp;video/mp2t;video/x-ms-wmv;video/x-m4v;audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/mp4;audio/x-wav;
StartupWMClass=mpv-extended
